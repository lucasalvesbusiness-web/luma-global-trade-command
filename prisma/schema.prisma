// B2B Trust Network — pivot baseline schema (SQLite variant).
// Canonical reference: docs/06-operational-ontology-and-object-model.md
//
// Status fields are TEXT with string literal unions enforced at runtime
// via Zod and at compile time via lib/types/enums.ts. To migrate back
// to Postgres, replace the provider, restore native enums, and re-add
// @db.Text / @db.Decimal where annotated below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Identity (Auth.js v5 + magic link)
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  // UserRole: MEMBER | ADMIN
  role          String    @default("MEMBER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  companyMembers    CompanyMember[]
  artifactsUploaded VerificationArtifact[] @relation("ArtifactUploader")
  artifactsReviewed VerificationArtifact[] @relation("ArtifactReviewer")
  evidencesUploaded Evidence[]             @relation("EvidenceUploader")
  evidencesAccepted Evidence[]             @relation("EvidenceAcceptor")
  messagesSent      DealRoomMessage[]
  invitationsSent   CompanyInvitation[]    @relation("InvitationInviter")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────
// Company
// ─────────────────────────────────────────────────────────

model Company {
  id                 String             @id @default(cuid())
  slug               String             @unique
  legalName          String
  tradeName          String?
  taxId              String             @unique // CNPJ digits-only
  description        String?
  city               String?
  state              String?
  // SQLite: stored as Float instead of Decimal(9,6).
  latitude           Float?
  longitude          Float?
  serviceRadiusKm    Int?
  // VerificationStatus: UNVERIFIED | EMAIL_VERIFIED | DOC_VERIFIED
  verificationStatus String             @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members         CompanyMember[]
  offerings       ServiceOffering[]
  artifacts       VerificationArtifact[]
  invitations     CompanyInvitation[]
  dealsAsBuyer    DealRoom[]             @relation("DealRoomBuyer")
  dealsAsSupplier DealRoom[]             @relation("DealRoomSupplier")
  reviewsGiven    Review[]               @relation("ReviewRater")
  reviewsReceived Review[]               @relation("ReviewRated")
  watchesGiven    CompanyWatch[]         @relation("WatchWatcher")
  watchesReceived CompanyWatch[]         @relation("WatchWatched")
  activityActed   ActivityEvent[]        @relation("ActivityActor")
  activityAbout   ActivityEvent[]        @relation("ActivitySubject")
}

model CompanyWatch {
  id                String   @id @default(cuid())
  watcherCompanyId  String
  watchedCompanyId  String
  createdAt         DateTime @default(now())

  watcher Company @relation("WatchWatcher", fields: [watcherCompanyId], references: [id], onDelete: Cascade)
  watched Company @relation("WatchWatched", fields: [watchedCompanyId], references: [id], onDelete: Cascade)

  @@unique([watcherCompanyId, watchedCompanyId])
  @@index([watchedCompanyId])
}

// Public-facing activity feed (distinct from AuditEvent which is
// internal forensic trail).
model ActivityEvent {
  id               String   @id @default(cuid())
  // DEAL_CONFIRMED | COMPANY_VERIFIED | COMPANY_JOINED
  type             String
  actorCompanyId   String
  subjectCompanyId String?
  dealRoomId       String?
  // PUBLIC | NETWORK | PRIVATE
  visibility       String   @default("PUBLIC")
  metadata         Json?
  createdAt        DateTime @default(now())

  actorCompany   Company  @relation("ActivityActor", fields: [actorCompanyId], references: [id], onDelete: Cascade)
  subjectCompany Company? @relation("ActivitySubject", fields: [subjectCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorCompanyId, createdAt])
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  // CompanyMemberRole: OWNER | COMMERCIAL | OPERATIONS | FINANCE | BUYER
  role      String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model ServiceOffering {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  subcategory String?
  // DealTemplate: ONE_OFF | RECURRING | PRODUCT_SUPPLY
  modality    String
  description String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
}

model CompanyInvitation {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  // CompanyMemberRole sem BUYER: OWNER | COMMERCIAL | OPERATIONS | FINANCE
  role         String
  token        String    @unique
  // PENDING | ACCEPTED | REVOKED | EXPIRED
  status       String    @default("PENDING")
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([companyId, status])
  @@index([email])
}

model VerificationArtifact {
  id           String    @id @default(cuid())
  companyId    String
  // VerificationArtifactKind: TAX_ID_CARD | ADDRESS_PROOF | OTHER
  kind         String
  // VerificationArtifactStatus: PENDING | APPROVED | REJECTED
  status       String    @default("PENDING")
  url          String
  hash         String?
  notes        String?
  uploadedById String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ArtifactUploader", fields: [uploadedById], references: [id])
  reviewedBy User?   @relation("ArtifactReviewer", fields: [reviewedById], references: [id])

  @@index([companyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────
// DealRoom — transactional core
// ─────────────────────────────────────────────────────────

model DealRoom {
  id                String   @id @default(cuid())
  buyerCompanyId    String
  supplierCompanyId String
  // DealTemplate: ONE_OFF | RECURRING | PRODUCT_SUPPLY
  template          String
  // DealRoomStatus: OPENED | SCOPED | QUOTED | ACCEPTED | IN_PROGRESS |
  // DELIVERED | CONFIRMED | CLOSED | DISPUTED | CANCELLED
  status            String   @default("OPENED")
  title             String
  // SQLite stores Json as text; Prisma serializes/deserializes.
  scopePayload      Json?
  quoteCents        Int?
  quoteCurrency     String?  @default("BRL")
  openedAt          DateTime @default(now())
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  confirmedAt       DateTime?
  closedAt          DateTime?
  disputedAt        DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime @updatedAt

  buyerCompany    Company           @relation("DealRoomBuyer", fields: [buyerCompanyId], references: [id])
  supplierCompany Company           @relation("DealRoomSupplier", fields: [supplierCompanyId], references: [id])
  cycles          DeliveryCycle[]
  evidences       Evidence[]
  messages        DealRoomMessage[]

  @@index([buyerCompanyId])
  @@index([supplierCompanyId])
  @@index([status])
}

model DeliveryCycle {
  id          String    @id @default(cuid())
  dealRoomId  String
  ordinal     Int
  // DeliveryCycleStatus: SCHEDULED | DELIVERED | CONFIRMED | CANCELLED
  status      String    @default("SCHEDULED")
  scheduledAt DateTime?
  deliveredAt DateTime?
  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  dealRoom  DealRoom   @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  evidences Evidence[]

  @@unique([dealRoomId, ordinal])
  @@index([dealRoomId])
}

model Evidence {
  id           String    @id @default(cuid())
  dealRoomId   String
  cycleId      String?
  // EvidenceKind: PHOTO | DOC | SIGNATURE | INVOICE_PREVIEW
  kind         String
  url          String
  caption      String?
  uploadedById String
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  dealRoom   DealRoom       @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  cycle      DeliveryCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  acceptedBy User?          @relation("EvidenceAcceptor", fields: [acceptedById], references: [id])

  @@index([dealRoomId])
  @@index([cycleId])
}

model DealRoomMessage {
  id         String   @id @default(cuid())
  dealRoomId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  dealRoom DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([dealRoomId])
}

// ─────────────────────────────────────────────────────────
// Review (auto-created on DealRoom CONFIRMED)
// ─────────────────────────────────────────────────────────

model Review {
  id             String    @id @default(cuid())
  dealRoomId     String
  raterCompanyId String
  ratedCompanyId String
  rating         Int?
  comment        String?
  category       String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  raterCompany Company @relation("ReviewRater", fields: [raterCompanyId], references: [id])
  ratedCompany Company @relation("ReviewRated", fields: [ratedCompanyId], references: [id])

  @@unique([dealRoomId, raterCompanyId])
  @@index([ratedCompanyId])
  @@index([raterCompanyId])
}

// ─────────────────────────────────────────────────────────
// Audit (polymorphic)
// ─────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  fromStatus String?
  toStatus   String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
