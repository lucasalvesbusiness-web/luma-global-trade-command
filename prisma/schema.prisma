// B2B Trust Network — pivot baseline schema
// Canonical reference: docs/06-operational-ontology-and-object-model.md
// F1: Company expanded with location, ServiceOffering, VerificationArtifact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Identity (Auth.js v5 + magic link)
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  companyMembers  CompanyMember[]
  artifactsUploaded VerificationArtifact[] @relation("ArtifactUploader")
  artifactsReviewed VerificationArtifact[] @relation("ArtifactReviewer")
}

enum UserRole {
  MEMBER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────
// Company
// ─────────────────────────────────────────────────────────

enum VerificationStatus {
  UNVERIFIED
  EMAIL_VERIFIED
  DOC_VERIFIED
}

enum CompanyMemberRole {
  OWNER
  COMMERCIAL
  OPERATIONS
  FINANCE
  BUYER
}

enum DealTemplate {
  ONE_OFF
  RECURRING
  PRODUCT_SUPPLY
}

model Company {
  id                 String             @id @default(cuid())
  slug               String             @unique
  legalName          String
  tradeName          String?
  taxId              String             @unique // CNPJ (digits only)
  description        String?            @db.Text
  city               String?
  state              String?
  // Location stored as Decimal pair; PostGIS Point materialized via SQL view in F2.
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  serviceRadiusKm    Int?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members      CompanyMember[]
  offerings    ServiceOffering[]
  artifacts    VerificationArtifact[]
}

model CompanyMember {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMemberRole
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model ServiceOffering {
  id          String       @id @default(cuid())
  companyId   String
  category    String       // e.g. "refrigeração", "elétrica", "TI"
  subcategory String?
  modality    DealTemplate
  description String?      @db.Text
  createdAt   DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
}

enum VerificationArtifactKind {
  TAX_ID_CARD       // cartão CNPJ
  ADDRESS_PROOF
  OTHER
}

enum VerificationArtifactStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationArtifact {
  id          String                       @id @default(cuid())
  companyId   String
  kind        VerificationArtifactKind
  status      VerificationArtifactStatus   @default(PENDING)
  url         String                       // signed URL or blob path
  hash        String?
  notes       String?                      @db.Text
  uploadedById String
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime                     @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ArtifactUploader", fields: [uploadedById], references: [id])
  reviewedBy User?   @relation("ArtifactReviewer", fields: [reviewedById], references: [id])

  @@index([companyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────
// Audit (polymorphic — reused across DealRoom, Company, Review, Evidence)
// ─────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  fromStatus String?
  toStatus   String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
