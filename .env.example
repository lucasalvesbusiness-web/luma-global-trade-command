############################################
# LUMA GLOBAL TRADE COMMAND — .env.example
# Copie para .env e ajuste conforme o seu setup local.
############################################

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=luma
POSTGRES_PASSWORD=luma_dev_password
POSTGRES_DB=luma_gtc
POSTGRES_PORT=5432

# Prisma usa esta URL para conectar ao Postgres local
DATABASE_URL="postgresql://luma:luma_dev_password@localhost:5432/luma_gtc?schema=public"
# Em dev: igual ao DATABASE_URL. Em prod (Vercel/Neon): use POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://luma:luma_dev_password@localhost:5432/luma_gtc?schema=public"

# --- Auth.js v5 ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="replace_me_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- SMTP ---
# Em dev local (Mailpit): host=localhost, port=1025, sem auth.
# Em prod (Resend): host=smtp.resend.com, port=587, user=resend, password=<API key>.
#   - Crie API key em https://resend.com/api-keys
#   - Verifique um domínio em https://resend.com/domains (necessário para enviar a destinatários externos).
#   - Sem domínio verificado: use SMTP_FROM=onboarding@resend.dev (só envia ao e-mail da conta).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Luma Global Trade Command <no-reply@luma.local>"
MAILPIT_UI_PORT=8025

# Inbox do time comercial Luma — recebe notificações de novas propostas
LUMA_INTERNAL_INBOX=commercial@luma.local

# --- Mapbox ---
# Crie uma conta gratuita em https://account.mapbox.com e gere um token público.
# Restrinja o token por domínio em produção.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.replace_me"

# --- Feature flags (MVP) ---
FEATURE_FIELD_INTELLIGENCE=true
FEATURE_COMPLIANCE_PREVIEW=true

# --- Logging ---
LOG_LEVEL=info

# --- Adminer (DB UI em dev) ---
ADMINER_PORT=8080

# --- Site password (staging gate) ---
# Quando setado, o middleware exige Basic Auth em todas as rotas.
# Em dev local, deixe vazio para acesso direto.
# Em produção/staging Vercel, gere uma senha forte e compartilhe com investidor/sócio.
SITE_USERNAME=luma
SITE_PASSWORD=

# --- Vercel Blob (uploads de fotos de campo) ---
# Em prod: injetado automaticamente pelo Vercel.
# Em dev: gere em vercel.com/dashboard → Storage → Blob → .env.local snippet.
BLOB_READ_WRITE_TOKEN=

# --- Cron secret (vercel.json) ---
# Bearer obrigatório para /api/cron/*. Gere com: openssl rand -hex 32.
# Sem este secret, em prod o cron retorna 401.
CRON_SECRET=

# --- Rate limit (Upstash Redis) ---
# Em prod: crie um Redis grátis em https://console.upstash.com/redis → REST snippet.
# Sem essas vars, o limiter degrada para no-op (todo request passa).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry ---
# Em prod: crie projeto em sentry.io. Sem DSN, Sentry é no-op.
# NEXT_PUBLIC_SENTRY_DSN é a mesma DSN, exposta no client (sem segredo).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- CSP enforcement ---
# 0 (default): CSP em Report-Only (não bloqueia, só reporta).
# 1: enforcing. Flipar apenas após 24h de validações sem violações inesperadas.
CSP_ENFORCE=0

# --- Mail toggle ---
# 1: pula todos os envios de e-mail (útil em testes locais sem Mailpit).
# Em prod: deixe vazio. transport.ts lança erro se SMTP não estiver configurado.
MAIL_DISABLED=

# --- Seed guard ---
# Define como '1' para permitir rodar pnpm prisma:seed em NODE_ENV=production
# (necessário em scripts de bootstrap controlado). Em CI/dev fica vazio.
SEED_ALLOWED=
