############################################
# B2B Trust Network — .env.example
# Copie para .env e ajuste conforme o seu setup local.
############################################

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_dev_password
POSTGRES_DB=b2b_trust
POSTGRES_PORT=5432

DATABASE_URL="postgresql://b2b:b2b_dev_password@localhost:5432/b2b_trust?schema=public"
DIRECT_URL="postgresql://b2b:b2b_dev_password@localhost:5432/b2b_trust?schema=public"

# --- Auth.js v5 ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="replace_me_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- SMTP (Mailpit em dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="B2B Trust Network <no-reply@b2btrust.local>"
MAILPIT_UI_PORT=8025

# --- Mapbox ---
# Crie uma conta gratuita em https://account.mapbox.com e gere um token público.
# Sem este token, o CompanyMap renderiza um fallback textual.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.replace_me"

# --- Logging ---
LOG_LEVEL=info

# --- Adminer (DB UI em dev) ---
ADMINER_PORT=8080

# --- Site password (staging gate) ---
# Quando setado, o middleware exige Basic Auth em todas as rotas.
SITE_USERNAME=
SITE_PASSWORD=

# --- Vercel Blob (uploads de evidências em F3) ---
BLOB_READ_WRITE_TOKEN=

# --- Rate limit (Upstash Redis) ---
# Sem essas vars, o limiter degrada para no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- CSP enforcement ---
CSP_ENFORCE=0

# --- Mail toggle ---
MAIL_DISABLED=
